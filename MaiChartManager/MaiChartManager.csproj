<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsLinuxBuild Condition="$(Configuration.StartsWith('Linux'))">true</IsLinuxBuild>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Platforms>x64</Platforms>
    <IsTransformWebConfigDisabled>True</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>True</StaticWebAssetsEnabled>
    <ValidateExecutableReferencesMatchSelfContained>False</ValidateExecutableReferencesMatchSelfContained>
    <PublishTrimmed>False</PublishTrimmed>
    <PublishAot>False</PublishAot>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>NU1605</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release;Crack;LinuxDebug;LinuxRelease</Configurations>
    <PublishDir>..\Packaging\Pack</PublishDir>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <CETCompat>false</CETCompat>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsLinuxBuild)' != 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>MaiChartManager.Program</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsLinuxBuild)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <StartupObject>MaiChartManager.LinuxProgram</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <IsPublishable>False</IsPublishable>
    <DefineConstants>TRACE;CRACK</DefineConstants>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <IsPublishable>True</IsPublishable>
    <DefineConstants />
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Crack'">
    <IsPublishable>True</IsPublishable>
    <DefineConstants>CRACK</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='LinuxDebug'">
    <IsPublishable>False</IsPublishable>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='LinuxRelease'">
    <IsPublishable>True</IsPublishable>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\AquaMai\AquaMai.Config.HeadlessLoader\AquaMai.Config.HeadlessLoader.csproj" />
    <ProjectReference Include="..\MaiLib\MaiLib.csproj" />
    <ProjectReference Include="..\SimaiSharp\SimaiSharp\SimaiSharp.csproj" />
    <ProjectReference Include="..\MuConvert\MuConvert.csproj" />
    <!-- 音频依赖已跨平台化：SonicAudioLib 已转 netstandard2.0，两平台都引（去掉 Condition） -->
    <ProjectReference Include="..\SonicAudioTools\Source\SonicAudioLib\SonicAudioLib.csproj" />
    <!-- AcbCore（netstandard2.0）包含 ACB（Xv2CoreLib.ACB）+ VGAudio，覆盖主项目所需，
         替代原来的 net47 大库 LB_Common / Xv2CoreLib，两平台都引 -->
    <ProjectReference Include="..\XV2-Tools\AcbCore\AcbCore.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsLinuxBuild)' != 'true'">
    <PackageReference Include="DesktopBridge.Helpers" Version="1.2.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <PackageReference Include="SingleInstanceCore" Version="2.2.2" />
    <PackageReference Include="Vanara.Windows.Forms" Version="4.2.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsLinuxBuild)' == 'true'">
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- Photino.NET：Linux 下作为原生窗口宿主（底层走系统 WebKitGTK），仅 Linux 构建引用 -->
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>
  <ItemGroup>
    <!-- Mono.Cecil：mod 配置/手动安装读 .NET 程序集用，两平台统一走 NuGet
         （原 Windows 用 Libs\Mono.Cecil.dll，已去掉） -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="idunno.Authentication.Basic" Version="2.4.0" />
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <PackageReference Include="LibNMeCab.IpaDicBin" Version="0.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.15.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="PeNet" Version="5.1.0" />
    <PackageReference Include="PeNet.Asn1" Version="2.0.2" />
    <PackageReference Include="Sentry" Version="5.16.2" />
    <PackageReference Include="Sentry.AspNetCore" Version="5.16.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.11" />
    <PackageReference Include="Standart.Hash.xxHash" Version="4.0.5" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.4" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.0.1" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.0" />
    <PackageReference Include="Tomlyn" Version="0.16.3" />
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="YAXLib" Version="2.15.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Launcher.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Remove="Front\**" />
    <Compile Update="Browser.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Locale.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Locale.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <!-- Linux 下把已构建好的 Vue SPA（wwwroot）复制到输出目录，使其位于 exe 同级，
       与 StaticSettings.wwwroot（非 DEBUG 时为 exeDir/wwwroot）的查找路径一致，供 Kestrel 伺服。
       使用 Update 而非 Include：wwwroot 已被 Web SDK 隐式作为 Content 包含，这里只补充复制元数据，避免重复项。 -->
  <ItemGroup Condition="'$(IsLinuxBuild)' == 'true'">
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsLinuxBuild)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Remove="AppMain.cs" />
    <Compile Remove="AppMain.g.cs" />
    <Compile Remove="Browser.cs" />
    <Compile Remove="Browser.Designer.cs" />
    <Compile Remove="OobeBrowser.cs" />
    <Compile Remove="Launcher.cs" />
    <Compile Remove="Launcher.Designer.cs" />
    <Compile Remove="AppLifecycleManager.cs" />
    <Compile Remove="WebViewHelper.cs" />
    <Compile Remove="IapManager.cs" />
    <Compile Remove="OfflineReg.cs" />
    <Compile Remove="Utils/WinUtils.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Front\**" />
    <Content Remove="WannaCRI\**" />
    <None Include="..\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Front\**" />
    <None Remove="WannaCRI\**" />
    <None Update="AquaMai\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 仅 Windows 构建内置 ffmpeg.exe/ffprobe.exe；Linux 用系统 ffmpeg，复制这些 PE 文件
         不仅没用，还会被 File.Exists 命中导致误用（exec 报 EACCES）。 -->
    <None Update="FFMpeg\**" Condition="'$(IsLinuxBuild)' != 'true'">
      <TargetPath>%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\JudgeDisplay4B\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\*">
      <TargetPath>%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
      Remove="C:\Users\Clansty\.nuget\packages\naudio.vorbis\1.5.0\contentFiles\any\netstandard2.0\README.md" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Locale.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Locale.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Locale.zh-hans.resx">
      <DependentUpon>Locale.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Locale.zh-hant.resx">
      <DependentUpon>Locale.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>