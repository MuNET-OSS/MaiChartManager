<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsLinuxBuild Condition="$(Configuration.StartsWith('Linux'))">true</IsLinuxBuild>
    <TargetFramework Condition="'$(IsLinuxBuild)' == 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(IsLinuxBuild)' != 'true'">net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Platforms>x64</Platforms>
    <IsTransformWebConfigDisabled>True</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>True</StaticWebAssetsEnabled>
    <OutputType Condition="'$(IsLinuxBuild)' == 'true'">Exe</OutputType>
    <OutputType Condition="'$(IsLinuxBuild)' != 'true'">WinExe</OutputType>
    <ValidateExecutableReferencesMatchSelfContained>False</ValidateExecutableReferencesMatchSelfContained>
    <RuntimeIdentifier Condition="'$(IsLinuxBuild)' == 'true'">linux-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(IsLinuxBuild)' != 'true'">win-x64</RuntimeIdentifier>
    <PublishTrimmed>False</PublishTrimmed>
    <PublishAot>False</PublishAot>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <StartupObject>MaiChartManager.Program</StartupObject>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <UseWindowsForms Condition="'$(IsLinuxBuild)' != 'true'">true</UseWindowsForms>
    <NoWarn>NU1605</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release;Crack;LinuxDebug;LinuxRelease</Configurations>
    <PublishDir>..\Packaging\Pack</PublishDir>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <CETCompat>false</CETCompat>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants Condition="'$(IsLinuxBuild)' != 'true'">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <IsPublishable>False</IsPublishable>
    <DefineConstants>TRACE;CRACK</DefineConstants>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <IsPublishable>True</IsPublishable>
    <DefineConstants/>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Crack'">
    <IsPublishable>True</IsPublishable>
    <DefineConstants>CRACK</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='LinuxDebug'">
    <IsPublishable>False</IsPublishable>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='LinuxRelease'">
    <IsPublishable>True</IsPublishable>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AquaMai\AquaMai.Config.HeadlessLoader\AquaMai.Config.HeadlessLoader.csproj" />
    <ProjectReference Include="..\MaiLib\MaiLib.csproj" />
    <ProjectReference Include="..\SimaiSharp\SimaiSharp\SimaiSharp.csproj" />
    <ProjectReference Include="..\MuConvert\MuConvert.csproj" />
    <ProjectReference Include="..\SonicAudioTools\Source\SonicAudioLib\SonicAudioLib.csproj" Condition="'$(IsLinuxBuild)' != 'true'" />
    <ProjectReference Include="..\XV2-Tools\LB_Common\LB_Common.csproj" Condition="'$(IsLinuxBuild)' != 'true'" />
    <ProjectReference Include="..\XV2-Tools\Xv2CoreLib\Xv2CoreLib.csproj" Condition="'$(IsLinuxBuild)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DesktopBridge.Helpers" Version="1.2.2" Condition="'$(IsLinuxBuild)' != 'true'"/>
    <PackageReference Include="idunno.Authentication.Basic" Version="2.4.0"/>
      <PackageReference Include="LibNMeCab" Version="0.10.2"/>
      <PackageReference Include="LibNMeCab.IpaDicBin" Version="0.10.0"/>
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0"/>
      <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.15.0"/>
      <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" Condition="'$(IsLinuxBuild)' != 'true'"/>
      <PackageReference Include="NAudio" Version="2.2.1"/>
    <PackageReference Include="NAudio.Lame" Version="2.1.0"/>
      <PackageReference Include="NAudio.Vorbis" Version="1.5.0"/>
      <PackageReference Include="PeNet" Version="5.1.0" />
      <PackageReference Include="PeNet.Asn1" Version="2.0.2" />
      <PackageReference Include="Sentry" Version="5.16.2"/>
      <PackageReference Include="Sentry.AspNetCore" Version="5.16.2"/>
    <PackageReference Include="SingleInstanceCore" Version="2.2.2" Condition="'$(IsLinuxBuild)' != 'true'"/>
      <PackageReference Include="SixLabors.ImageSharp" Version="2.1.11"/>
    <PackageReference Include="Standart.Hash.xxHash" Version="4.0.5"/>
      <PackageReference Include="AssetsTools.NET" Version="3.0.4" />
      <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.1"/>
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.0.1"/>
      <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.0"/>
      <PackageReference Include="Tomlyn" Version="0.16.3"/>
    <PackageReference Include="Vanara.Windows.Forms" Version="4.2.1" Condition="'$(IsLinuxBuild)' != 'true'"/>
      <PackageReference Include="Xabe.FFmpeg" Version="6.0.2"/>
      <PackageReference Include="YamlDotNet" Version="16.3.0"/>
      <PackageReference Include="YAXLib" Version="2.15.0"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Launcher.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Remove="Front\**"/>
    <Compile Update="Browser.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Remove="Libs\**"/>
    <Compile Update="Locale.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Locale.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="'$(IsLinuxBuild)' == 'true'">
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsLinuxBuild)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Remove="AppMain.cs" />
    <Compile Remove="AppMain.g.cs" />
    <Compile Remove="Browser.cs" />
    <Compile Remove="Browser.Designer.cs" />
    <Compile Remove="OobeBrowser.cs" />
    <Compile Remove="Launcher.cs" />
    <Compile Remove="Launcher.Designer.cs" />
    <Compile Remove="AppLifecycleManager.cs" />
    <Compile Remove="WebViewHelper.cs" />
    <Compile Remove="IapManager.cs" />
    <Compile Remove="OfflineReg.cs" />
    <Compile Remove="Utils/WinUtils.cs" />
    <Compile Remove="Utils/Audio.cs" />
    <Compile Remove="Utils/CriUtils.cs" />
    <Compile Remove="Utils/AudioConvert.cs" />
    <Compile Remove="Controllers/Music/CueConvertController.cs" />
    <Compile Remove="Controllers/Music/VrcProcessController.cs" />
    <Compile Remove="Controllers/Charts/ImportChartController.cs" />
    <Compile Remove="Controllers/Tools/AudioConvertToolController.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Front\**"/>
    <Content Remove="WannaCRI\**"/>
    <Content Remove="Libs\**"/>
    <None Include="..\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Front\**"/>
    <None Remove="WannaCRI\**"/>
    <None Remove="Libs\**"/>
    <None Update="x64\Texture2DDecoderNative.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="AquaMai\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="FFMpeg\**">
      <TargetPath>%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\JudgeDisplay4B\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\*">
      <TargetPath>%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Remove="C:\Users\Clansty\.nuget\packages\naudio.vorbis\1.5.0\contentFiles\any\netstandard2.0\README.md" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AssetStudio" Condition="'$(IsLinuxBuild)' != 'true'">
      <HintPath>Libs\AssetStudio.dll</HintPath>
    </Reference>
    <Reference Include="AssetStudioUtility" Condition="'$(IsLinuxBuild)' != 'true'">
      <HintPath>Libs\AssetStudioUtility.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil" Condition="'$(IsLinuxBuild)' != 'true'">
      <HintPath>Libs\Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Locale.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Locale.Designer.cs</LastGenOutput>
    </EmbeddedResource>
      <EmbeddedResource Update="Locale.zh-hans.resx">
          <DependentUpon>Locale.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Locale.zh-hant.resx">
          <DependentUpon>Locale.resx</DependentUpon>
      </EmbeddedResource>
  </ItemGroup>
</Project>
